// Shared build settings for all targets. Secrets (team ID, API keys) come
// from Secrets.xcconfig — gitignored, optional so a clean checkout still
// builds unsigned (CI does exactly that).
#include? "Secrets.xcconfig"

BEMBEL_BUNDLE_ID_PREFIX = de.mauricejobst

IPHONEOS_DEPLOYMENT_TARGET = 18.5
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(BEMBEL_TEAM_ID)

GENERATE_INFOPLIST_FILE = YES
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0

LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

ENABLE_USER_SCRIPT_SANDBOXING = YES
