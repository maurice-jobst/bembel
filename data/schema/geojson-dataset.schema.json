{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maurice-jobst/bembel/data/schema/geojson-dataset.schema.json",
  "title": "BEMBEL curated GeoJSON POI dataset",
  "description": "Every curated point layer the app ships (drinking fountains first). Generated by a script under scripts/, never hand-edited. scripts/validate_data.py implements these checks in stdlib Python plus two the schema cannot express — 'ags' must exist in rings.json and 'ring' must be the ring rings.json assigns it, and coordinates must fall inside the Rhein-Main box, which is what actually catches a swapped lat/lon pair. This schema is the citable definition; the validator is the enforcing check.",
  "type": "object",
  "required": ["version", "id", "type", "features"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Dataset id — matches the manifest key and the bundled filename."
    },
    "type": { "const": "FeatureCollection" },
    "generator": {
      "type": "string",
      "description": "Repo-relative path of the script that produced this file."
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "geometry", "properties"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "Feature" },
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "additionalProperties": false,
            "description": "Point only. A POI is a point; widening this to lines or polygons is a version bump, not a quiet edit.",
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" },
                "description": "GeoJSON order: [longitude, latitude]."
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["name", "ags", "ring", "sources", "updated"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 300 },
              "ags": { "type": "string", "pattern": "^[0-9]{8}$" },
              "ring": { "enum": ["frankfurt", "kernraum", "rheinmain"] },
              "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^https?://" }
              }
            },
            "additionalProperties": {
              "description": "Dataset-specific fields are facts only: scalars, or lists of scalars, strings ≤300 chars with no newlines. There is deliberately no place for prose to live.",
              "anyOf": [
                { "type": ["boolean", "integer", "number", "null"] },
                { "type": "string", "maxLength": 300 },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      { "type": ["boolean", "integer", "number", "null"] },
                      { "type": "string", "maxLength": 300 }
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
