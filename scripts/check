#!/usr/bin/env bash
# Fast pre-PR check: the three make targets that need no Xcode and no simulator.
# `make test` and `make build` stay in CI. Exits with make's status.
set -euo pipefail
cd "$(dirname "$0")/.."
scripts/context-cap AGENTS.md 100 || { echo "check: AGENTS.md over its 100-line cap (dotfiles#99)" >&2; exit 1; }
exec make validate test-data format-check
