{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maurice-jobst/bembel/data/schema/rings.schema.json",
  "title": "BEMBEL region rings table",
  "description": "Generated by scripts/generate_rings.py — never hand-edited. scripts/validate_data.py implements these checks in stdlib Python; this schema is the citable definition.",
  "type": "object",
  "required": ["version", "municipalities"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["provisional", "generated"] },
    "definition": { "type": "string" },
    "source": { "type": "string" },
    "municipalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ags", "name", "ring"],
        "additionalProperties": false,
        "properties": {
          "ags": { "type": "string", "pattern": "^[0-9]{8}$" },
          "name": { "type": "string", "minLength": 1 },
          "ring": { "enum": ["frankfurt", "kernraum", "rheinmain"] }
        }
      }
    }
  }
}
